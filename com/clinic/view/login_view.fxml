<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic.controller.LoginController"
           stylesheets="@login_style.css" prefWidth="900" prefHeight="600">

    <VBox alignment="CENTER" maxWidth="380" maxHeight="450" styleClass="login-card" spacing="20">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

        <VBox alignment="CENTER" spacing="5">
            <Label text="ClinicCare OS" styleClass="app-title"/>
            <Label text="Clinical Management System" styleClass="app-subtitle"/>
        </VBox>

        <Separator prefWidth="200"/>

        <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>

        <VBox spacing="15" fillWidth="true">
            <VBox spacing="5">
                <Label text="Username" styleClass="input-label"/>
                <TextField fx:id="txtUsername" promptText="Enter your username" styleClass="custom-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" styleClass="input-label"/>
                <PasswordField fx:id="txtPassword" promptText="Enter your password" styleClass="custom-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="System Station Role" styleClass="input-label"/>
                <ComboBox fx:id="comboRole" promptText="Select your role" prefWidth="320" styleClass="custom-combo"/>
            </VBox>
        </VBox>

        <Button fx:id="btnLogin" 
        text="Login to Station" 
        onAction="#handleLogin"
        maxWidth="Infinity"
        prefHeight="42.0"
        style="-fx-background-color: #0088cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8px; -fx-cursor: hand;" />

        <Label text="Local Network Server Connected" styleClass="footer-text"/>
    </VBox>
</StackPane>