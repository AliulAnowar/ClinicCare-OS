               <children>
                  <Label text="MAIN" textFill="#94a3b8">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <Label text="HUB" textFill="#38bdf8">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="MCP" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label text="Model Context Protocol" textFill="#cbd5e1">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <Label style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 2 6;" text="Connected">
                           <font>
                              <Font size="9.0" />
                           </font>
                        </Label>
                        <Label style="-fx-background-color: #9333ea; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 2 6;" text="Real-time">
                           <font>
                              <Font size="9.0" />
                           </font>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>

            <!-- LEFT INTEGRATION CARDS -->
            <VBox alignment="CENTER_LEFT" maxWidth="200.0" spacing="25.0" StackPane.alignment="CENTER_LEFT">
               <children>
                  <!-- Card 1 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                     <children>
                        <StackPane prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #1e3a8a; -fx-background-radius: 8;">
                           <children>
                              <Label text="AI" textFill="#60a5fa">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="AI Host App" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label text="Claude Desktop / IDEs" textFill="#64748b">
                                 <font>
                                    <Font size="10.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Card 2 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                     <children>
                        <StackPane prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #312e81; -fx-background-radius: 8;">
                           <children>
                              <Label text="VS" textFill="#a78bfa">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="IDEs" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label text="VS Code, Cursor, etc." textFill="#64748b">
                                 <font>
                                    <Font size="10.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Card 3 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                     <children>
                        <StackPane prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #064e3b; -fx-background-radius: 8;">
                           <children>
                              <Label text="DB" textFill="#34d399">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="Database Context" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label text="Clinical Records Data" textFill="#64748b">
                                 <font>
                                    <Font size="10.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- RIGHT INTEGRATION CARDS -->
            <VBox alignment="CENTER_RIGHT" maxWidth="200.0" spacing="20.0" StackPane.alignment="CENTER_RIGHT">
               <children>
                  <!-- Right Card 1 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                     <children>
                        <StackPane prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8;">
                           <children>
                              <Label text="🗄️" textFill="WHITE" />
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="Databases" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <Label text="Postgres, SQLite" textFill="#64748b">
                                 <font>
                                    <Font size="9.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Right Card 2 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                     <children>
                        <StackPane prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8;">
                           <children>
                              <Label text="📁" textFill="WHITE" />
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="Local Files" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <Label text="Docs, Code, Logs" textFill="#64748b">
                                 <font>
                                    <Font size="9.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Right Card 3 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                     <children>
                        <StackPane prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8;">
                           <children>
                              <Label text="🏥" textFill="WHITE" />
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="EHR/EMR Systems" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <Label text="Hospital Data Sync" textFill="#64748b">
                                 <font>
                                    <Font size="9.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Right Card 4 -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                     <children>
                        <StackPane prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8;">
                           <children>
                              <Label text="🐙" textFill="WHITE" />
                           </children>
                        </StackPane>
                        <VBox>
                           <children>
                              <Label text="Git &amp; Developer Tools" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <Label text="Version Control" textFill="#64748b">
                                 <font>
                                    <Font size="9.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </StackPane>
   </center>
   
   <!-- BOTTOM STATUS BAR -->
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="30.0" style="-fx-background-color: #090d16; -fx-padding: 0 15; -fx-border-color: #1e293b; -fx-border-width: 1 0 0 0;">
         <children>
            <Circle fill="#22c55e" radius="4.0" />
            <Label text=" Status: System Operational" textFill="#94a3b8">
               <font>
                  <Font size="10.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Model Context Protocol (MCP) Architecture v1.0" textFill="#64748b">
               <font>
                  <Font size="10.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </bottom>

</BorderPane>